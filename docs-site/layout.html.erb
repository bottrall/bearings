<!doctype html>
<html lang="en">
  <head>
    <%= render.call('head', title: "#{page.title} · #{site.name}", description: page.description, canonical: page.canonical_url) -%>
    <link rel="alternate" type="text/markdown" href="<%= page.markdown_url %>">
    <%- if page.diagrams? -%>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs";

      const style = getComputedStyle(document.documentElement);
      const [paper, ink, fontFamily] = ["--paper", "--ink", "--font-body"].map((name) => style.getPropertyValue(name).trim());

      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        themeCSS: ".node rect { rx: 0; ry: 0 }",
        flowchart: { curve: "linear", padding: 14 },
        themeVariables: {
          darkMode: matchMedia("(prefers-color-scheme: dark)").matches,
          fontFamily,
          fontSize: "15px",
          background: paper,
          primaryColor: paper,
          edgeLabelBackground: paper,
          primaryTextColor: ink,
          primaryBorderColor: ink,
          lineColor: ink,
        },
      });
      await document.fonts.ready;
      await mermaid.run();
    </script>
    <%- end -%>
  </head>
  <body>
    <%- guide_list = lambda do -%>
    <ul class="plain-list">
      <%- groups.each do |group| -%>
      <li>
        <span class="group"><%= group.label %></span>
        <ul class="plain-list">
          <%- group.pages.each do |p| -%>
          <li><a href="<%= p.url %>"<%= ' aria-current="page"' if p == page %>><%= ERB::Util.h(p.title) %></a></li>
          <%- end -%>
        </ul>
      </li>
      <%- end -%>
    </ul>
    <%- end -%>
    <%- toc_list = lambda do -%>
    <ul class="plain-list">
      <%- toc.each do |entry| -%>
      <li><a href="#<%= entry[:id] %>"><%= entry[:title] %></a></li>
      <%- end -%>
    </ul>
    <%- end -%>
    <%= render.call('masthead') -%>

    <div class="cols">
      <nav class="tree" aria-label="Guides">
        <p class="cap">Guides</p>
        <%- guide_list.call -%>
      </nav>
      <details class="menu">
        <summary>Guides</summary>
        <%- guide_list.call -%>
      </details>

      <main>
        <header class="head">
          <p class="file">
            <span><%= page.source_path %></span>
            <span class="views">
              <b>Rendered</b>
              <a href="<%= page.markdown_url %>">Markdown</a>
              <a href="<%= page.edit_url %>">Edit</a>
            </span>
          </p>
          <h1><%= ERB::Util.h(page.title) %></h1>
        </header>
        <%- if toc.size >= 2 -%>
        <nav class="toc" aria-label="On this page">
          <p class="cap">On this page</p>
          <%- toc_list.call -%>
        </nav>
        <details class="toc-menu">
          <summary>On this page</summary>
          <%- toc_list.call -%>
        </details>
        <%- end -%>
        <article>
          <%= body %>
        </article>
        <nav class="pager" aria-label="Previous and next">
          <%- if prev_page -%>
          <a rel="prev" href="<%= prev_page.url %>">Previous: <%= ERB::Util.h(prev_page.title) %></a>
          <%- end -%>
          <%- if next_page -%>
          <a rel="next" href="<%= next_page.url %>">Next: <%= ERB::Util.h(next_page.title) %></a>
          <%- end -%>
        </nav>
      </main>
    </div>
  </body>
</html>
