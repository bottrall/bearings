<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= page.title %> · <%= site.name %></title>
    <meta name="description" content="<%= page.description %>">
    <link rel="canonical" href="<%= page.canonical_url %>">
    <link rel="alternate" type="text/markdown" href="<%= page.markdown_url %>">
    <link rel="stylesheet" href="/site.css">
    <%- if page.diagrams? -%>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true });
    </script>
    <%- end -%>
  </head>
  <body>
    <header class="masthead">
      <a class="name" href="/"><%= site.name %></a>
      <span class="version">v<%= version %></span>
      <a href="<%= site.repo %>">GitHub</a>
    </header>

    <div class="columns">
      <nav class="contents" aria-label="Guides">
        <%- groups.each do |group| -%>
        <h2><%= group.label %></h2>
        <ol>
          <%- group.pages.each do |p| -%>
          <li><a href="<%= p.url %>"<%= ' aria-current="page"' if p == page %>><%= p.title %></a></li>
          <%- end -%>
        </ol>
        <%- end -%>
      </nav>

      <main>
        <article>
          <p class="kicker"><%= page.group_label %> · <%= page.num %></p>
          <h1><%= page.title %></h1>
          <%- if toc.size >= 2 -%>
          <nav class="toc" aria-label="On this page">
            <ul>
              <%- toc.each do |entry| -%>
              <li><a href="#<%= entry[:id] %>"><%= entry[:title] %></a></li>
              <%- end -%>
            </ul>
          </nav>
          <%- end -%>
          <%= body %>
        </article>

        <p class="source">
          <a href="<%= page.markdown_url %>">Read this page as markdown</a> ·
          <a href="<%= page.edit_url %>">Edit it on GitHub</a>
        </p>

        <nav class="pager" aria-label="Previous and next">
          <%- if prev_page -%>
          <a rel="prev" href="<%= prev_page.url %>">← <%= prev_page.title %></a>
          <%- end -%>
          <%- if next_page -%>
          <a rel="next" href="<%= next_page.url %>"><%= next_page.title %> →</a>
          <%- end -%>
        </nav>
      </main>
    </div>
  </body>
</html>
