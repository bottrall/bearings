module Kramdown
  class Document
    def initialize: (String source, ?Hash[Symbol, untyped] options) -> void

    def root: () -> Kramdown::Element

    def options: () -> Hash[Symbol, untyped]
  end

  class Element
    def initialize: (Symbol type, ?untyped value, ?Hash[String, String]? attr, ?Hash[Symbol, untyped]? options) -> void

    def type: () -> Symbol

    def value: () -> untyped

    def value=: (untyped value) -> untyped

    def children: () -> Array[Kramdown::Element]

    def children=: (Array[Kramdown::Element] children) -> Array[Kramdown::Element]

    def attr: () -> Hash[String, String]

    def options: () -> Hash[Symbol, untyped]
  end

  module Converter
    class Html
      def self.convert: (Kramdown::Element tree, ?Hash[Symbol, untyped] options) -> [String, Array[String]]
    end
  end
end
