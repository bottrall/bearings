# rbs-inline reads `Data.define` only when assigned to a bare constant, not to the compact `Bearings::Kramdown::WithLexers`.
class Bearings::Kramdown::WithLexers < Data
  attr_reader lexers: Bearings::Kramdown::lexers

  def self.new: (Bearings::Kramdown::lexers lexers) -> instance
              | (lexers: Bearings::Kramdown::lexers) -> instance

  def self.members: () -> [ :lexers ]

  def members: () -> [ :lexers ]
end
